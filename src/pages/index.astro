---
import Layout from '../layouts/Layout.astro';

const title = "srcres's blog";
const description = 'Personal notes on programming, systems, tools, and the web.';
---

<Layout title={title} description={description}>
	<section class="intro">
		<h1>{title}</h1>
		<p class="lede">
			Personal notes on programming, systems, tools, and the web. This site is intentionally
			plain: mostly text, fast static pages, and a small CSS layer inspired by Bear Blog.
		</p>
	</section>

	<section aria-labelledby="recent-posts">
		<h2 id="recent-posts">Recent posts</h2>
		<div class="post-list">
			<article class="post-preview">
				<h3><a href="/">Hello, Astro</a></h3>
				<time datetime="2026-09-26">2026-09-26</time>
				<p>A first placeholder entry while the blog structure is taking shape.</p>
			</article>
		</div>
	</section>
</Layout>
