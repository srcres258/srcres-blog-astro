---
import BlogPost from '../../components/BlogPost.astro';
import { defaultLocale } from '../../i18n/config';
import { getLocalizedPosts, type BlogPost as BlogPostEntry } from '../../i18n/posts';

export async function getStaticPaths() {
	const posts = await getLocalizedPosts(defaultLocale);

	return posts.map(({ slug, post }) => ({
		params: { slug },
		props: { post, slug },
	}));
}

interface Props {
	post: BlogPostEntry;
	slug: string;
}

const { post, slug } = Astro.props;
---

<BlogPost post={post} locale={defaultLocale} slug={slug} />
