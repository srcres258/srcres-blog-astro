---
import BlogHome from '../../components/BlogHome.astro';
import { defaultLocale, localeCodes, type Locale } from '../../i18n/config';

export function getStaticPaths() {
	return localeCodes
		.filter((locale) => locale !== defaultLocale)
		.map((locale) => ({
			params: { lang: locale },
			props: { locale },
		}));
}

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
---

<BlogHome locale={locale} />
