---
import { render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import { locales, type Locale } from '../i18n/config';
import { getPostTranslations, postAlternates, type BlogPost } from '../i18n/posts';

interface Props {
	post: BlogPost;
	locale: Locale;
	/** Slug inside the locale, used to find translations of the same article. */
	slug: string;
}

const { post, locale, slug } = Astro.props;
const { Content } = await render(post);
const alternates = postAlternates(await getPostTranslations(slug));
---

<Layout
	title={post.data.title}
	description={post.data.description}
	locale={locale}
	path={`blog/${slug}/`}
	alternates={alternates}
>
	<article class="blog-post">
		<header>
			<h1>{post.data.title}</h1>
			<time datetime={post.data.pubDate.toISOString()}>
				{post.data.pubDate.toLocaleDateString(locales[locale].htmlLang)}
			</time>

			{
				post.data.tags.length > 0 && (
					<ul class="tag-list">
						{post.data.tags.map((tag) => (
							<li>{tag}</li>
						))}
					</ul>
				)
			}
		</header>

		<Content />
	</article>
</Layout>
