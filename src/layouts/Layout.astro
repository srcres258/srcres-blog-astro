---
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
}

const { title = "srcres's blog", description = 'A personal technical blog.' } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header>
			<a class="site-title" href="/">srcres's blog</a>
			<nav aria-label="Main navigation">
				<a href="/">Home</a>
			</nav>
		</header>

		<main>
			<slot />
		</main>

		<footer>
			<p>© {new Date().getFullYear()} srcres. Built with Astro.</p>
		</footer>
	</body>
</html>
